# Copy to .env (never commit .env). Real environment variables override these values.
AI_PROVIDER=none              # none | ollama | openai_compatible
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Optional OpenAI-compatible API (not required). Prompts are redacted but still leave your machine.
API_BASE_URL=
API_KEY=
API_MODEL=
AI_TIMEOUT_SECONDS=120
AI_TOP_N=3                    # how many top error groups the model refines
REDACT_EMAILS=true
MAX_LOG_SIZE_MB=50

# Optional Jira. Leave empty to only export reports. A ticket is created ONLY when you explicitly confirm it.
JIRA_BASE_URL=                # e.g. https://your-team.atlassian.net
JIRA_EMAIL=                   # Jira Cloud account email (auth=basic)
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=             # e.g. PAY
JIRA_ISSUE_TYPE=Bug
JIRA_AUTH=basic               # basic | bearer

# Save finished analyses (redacted) to a local SQLite file shown on the History page
STORE_HISTORY=true
DB_PATH=storage/history.db
